# --- Semantic RAG Logic ---
def query_semantic_rag(question, conn, embed_model, llm, k=5):
    query_vector = embed_model.encode(question).tolist()
    result = conn.execute("MATCH (c:Chunk) RETURN c.chunk_id, c.text, c.source_file, c.page_number, c.embedding")
    
    rows = []
    while result.has_next():
        row = result.get_next()
        rows.append((row[0], row[1], row[2], row[3], np.array(row[4])))
    
    q_vec = np.array(query_vector)
    scored = []
    for cid, text, src, page, emb in rows:
        sim = float(np.dot(q_vec, emb) / (np.linalg.norm(q_vec) * np.linalg.norm(emb) + 1e-9))
        scored.append({"chunk_id": cid, "text": text, "source": src, "page": page, "score": sim})
    
    top_k = sorted(scored, key=lambda x: x["score"], reverse=True)[:k]
    context = "\n\n".join([item["text"] for item in top_k])
    
