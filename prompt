# --- Graph RAG Logic ---
def query_graph_rag(question, conn, embed_model, llm, top_k=5, hops=2):
    q_vec = embed_model.encode(question, normalize_embeddings=True).tolist()
    
    # 1. Fetch Seed Nodes via Vector Index
    seeds_res = conn.execute("""
        CALL QUERY_VECTOR_INDEX('Entity', 'entity_hnsw', $q_vec,$top_k)
        YIELD node, distance
        RETURN node.entity_id, node.name, distance
        ORDER BY distance ASC
    """, {"q_vec": q_vec, "top_k": top_k})
    
    seeds_df = seeds_res.get_as_df()
    seed_ids = seeds_df['node.entity_id'].tolist()
    
    # 2. Get Subgraph
    id_list = "[" + ", ".join(f'"{eid}"' for eid in seed_ids) + "]"
    subgraph_res = conn.execute(f"""
        MATCH (h:Entity)-[r:Graph*1..{hops}]->(t:Entity)
        WHERE h.entity_id IN {id_list}
        UNWIND relationships(r) AS rel
        RETURN DISTINCT h.name AS head, rel.relation AS relation, t.name AS tail, rel.source_file AS source, rel.page_number AS page
    """)
